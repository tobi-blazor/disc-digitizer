<Window x:Class="DiscDigitalisierung.App.EinstellungenFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen" Width="720" SizeToContent="Height" MaxHeight="900"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Zeile" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="{Binding FehlerText}" Foreground="#D13438" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Speichern" Command="{Binding SpeichernCommand}" IsDefault="True" Style="{StaticResource Knopf}"/>
            <Button Content="Abbrechen" Command="{Binding AbbrechenCommand}" IsCancel="True" Style="{StaticResource Knopf}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Pfade" Style="{StaticResource Titel}" Margin="0,0,0,8"/>
                <Grid Style="{StaticResource Zeile}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Python" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding PythonPfad, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="…" Width="32" Margin="6,0,0,0" Command="{Binding WaehlenCommand}" CommandParameter="PythonPfad"/>
                </Grid>
                <Grid Style="{StaticResource Zeile}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Skript-Ordner" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SkriptOrdner, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="…" Width="32" Margin="6,0,0,0" Command="{Binding WaehlenCommand}" CommandParameter="SkriptOrdner"/>
                </Grid>
                <Grid Style="{StaticResource Zeile}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Arbeitsordner (DVD_ARBEIT)" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding ArbeitsOrdner, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="…" Width="32" Margin="6,0,0,0" Command="{Binding WaehlenCommand}" CommandParameter="ArbeitsOrdner"/>
                </Grid>
                <Grid Style="{StaticResource Zeile}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Video-Ziel (DVD_ZIEL)" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding DvdZiel, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="…" Width="32" Margin="6,0,0,0" Command="{Binding WaehlenCommand}" CommandParameter="DvdZiel"/>
                </Grid>
                <Grid Style="{StaticResource Zeile}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Musik-Ziel (MUSIK_ZIEL)" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding MusikZiel, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="…" Width="32" Margin="6,0,0,0" Command="{Binding WaehlenCommand}" CommandParameter="MusikZiel"/>
                </Grid>
                <Grid Style="{StaticResource Zeile}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Laufwerk" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Laufwerk, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="2" Text="z.B. E:" Style="{StaticResource Leise}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Text="Einlesen" Style="{StaticResource Titel}" Margin="0,12,0,8"/>
                <TextBlock Text="Nummern bei leeren Discs: im Hauptfenster umschalten (Durchnummeriert / Nachfragen / Erst testen)."
                           Style="{StaticResource Leise}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid Style="{StaticResource Zeile}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Weitere Argumente" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding WeitereEinlesenArgumente, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <TextBlock Text="Klänge" Style="{StaticResource Titel}" Margin="0,12,0,8"/>
                <ItemsControl ItemsSource="{Binding KlangZeilen}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Style="{StaticResource Zeile}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Anlass.Name}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.KlangOptionen, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Auswahl}" DisplayMemberPath="Name"/>
                                <DockPanel Grid.Column="2" Margin="6,0,0,0" Visibility="{Binding IstDatei, Converter={StaticResource BoolSicht}}">
                                    <Button DockPanel.Dock="Right" Content="…" Width="32" Margin="4,0,0,0" Command="{Binding DateiWaehlenCommand}"/>
                                    <TextBox Text="{Binding Datei, UpdateSourceTrigger=PropertyChanged}" ToolTip="wav, mp3, wma, m4a …"/>
                                </DockPanel>
                                <Button Grid.Column="3" Content="▶ Probe" Margin="6,0,0,0" Padding="8,2" Command="{Binding ProbehoerenCommand}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Style="{StaticResource Zeile}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Lautstärke" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding KlangLautstaerke}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding KlangLautstaerke, StringFormat={}{0} %}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Text="Windows-Klänge folgen der Windows-Lautstärke. Die Python-Skripte spielen im Programm keine eigenen Töne mehr."
                           Style="{StaticResource Leise}" TextWrapping="Wrap" Margin="0,0,0,4"/>

                <TextBlock Text="Umwandeln" Style="{StaticResource Titel}" Margin="0,12,0,8"/>
                <CheckBox Content="Umwandeln beim Programmstart automatisch starten" IsChecked="{Binding UmwandelnAutomatischStarten}" Margin="0,0,0,8"/>
                <Grid Style="{StaticResource Zeile}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Zeitfenster (--zeitfenster)" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Zeitfenster, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="2" Text="z.B. 22-07, leer = jederzeit" Style="{StaticResource Leise}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
                <Grid Style="{StaticResource Zeile}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Weitere Argumente" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding WeitereUmwandelnArgumente, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <TextBlock Text="Netzwerk" Style="{StaticResource Titel}" Margin="0,12,0,8"/>
                <Grid Style="{StaticResource Zeile}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Prüfintervall (Sekunden)" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding NetzwerkIntervallSekunden, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <TextBlock Text="Änderungen an Argumenten gelten ab dem nächsten Start des jeweiligen Skripts." Style="{StaticResource Leise}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
